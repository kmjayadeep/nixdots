#!/bin/sh
lock() {
  notify-send "Locking screen..."
  loginctl lock-session
}

# Living room light off before sleeping (only where services.haLightHooks is enabled). It must run before
# systemctl suspend: NetworkManager takes the network down as soon as sleep starts.
light_off() {
  command -v ha-light-sleep >/dev/null && ha-light-sleep
  return 0
}

case "$1" in
  lock)
    lock
    ;;
  logout)
    i3-msg exit
    ;;
  suspend)
    lock && light_off && systemctl suspend
    ;;
  hibernate)
    lock && light_off && systemctl hibernate
    ;;
  reboot)
    systemctl reboot
    ;;
  shutdown)
    systemctl poweroff
    ;;
  *)
    echo "Usage: $0 {lock|logout|suspend|hibernate|reboot|shutdown}"
    exit 2
esac

exit 0
